diff -ruN -x __pycache__ a/sources/app/feature_flags.c b/sources/app/feature_flags.c
--- a/sources/app/feature_flags.c
+++ b/sources/app/feature_flags.c
@@ -0,0 +1,24 @@
+#include "feature_flags.h"
+
+#include <string.h>
+
+static uint32_t rd32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+uint32_t gp100_feature_flags_parse(const uint8_t *block, size_t bytes)
+{
+    uint32_t flags;
+
+    if (block == NULL || bytes < GP100_FEATURE_FLAGS_BYTES || memcmp(block, "GPFL", 4) != 0) { return 0u; }
+    if ((uint32_t)(block[4] | (block[5] << 8)) != 1u || (uint32_t)(block[6] | (block[7] << 8)) != GP100_FEATURE_FLAGS_BYTES) { return 0u; }
+    flags = rd32(block + 8);
+    return (rd32(block + 12) == ~flags) ? flags : 0u;
+}
+
+uint32_t gp100_feature_flags(void)
+{
+    return gp100_feature_flags_parse((const uint8_t *)(uintptr_t)(0x60000000u + GP100_FEATURE_FLAGS_FLASH_OFFSET),
+                                     GP100_FEATURE_FLAGS_BYTES);
+}
diff -ruN -x __pycache__ a/sources/app/feature_flags.h b/sources/app/feature_flags.h
--- a/sources/app/feature_flags.h
+++ b/sources/app/feature_flags.h
@@ -0,0 +1,32 @@
+#ifndef GP100_FEATURE_FLAGS_H
+#define GP100_FEATURE_FLAGS_H
+
+/*
+ * Build-time feature switches stored in a small reserved flash block, written by the gp100-mods app into the update file.
+ * Little-endian layout, at flash offset GP100_FEATURE_FLAGS_FLASH_OFFSET:
+ *   0x00  char[4]  magic "GPFL"
+ *   0x04  u16      version (1)
+ *   0x06  u16      block size (0x40)
+ *   0x08  u32      flags
+ *   0x0C  u32      ~flags (integrity: a damaged or erased block means "no flags")
+ *   0x10  ...      unused (0xFF)
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define GP100_FEATURE_FLAGS_FLASH_OFFSET 0x001CBF00u
+#define GP100_FEATURE_FLAGS_BYTES        0x40u
+
+#define GP100_FEATURE_STARTER_PRESET     (1u << 0)   /* offer the built-in "Starter" preset in slot P01 while it is empty */
+
+/* Parse a block. Returns the flags, or 0 if the block is missing or invalid. */
+uint32_t gp100_feature_flags_parse(const uint8_t *block, size_t bytes);
+
+/* Flags of the running firmware (reads the block from the XIP flash window). */
+uint32_t gp100_feature_flags(void);
+
+static inline bool gp100_feature_enabled(uint32_t flag) { return (gp100_feature_flags() & flag) != 0u; }
+
+#endif
diff -ruN -x __pycache__ a/sources/app/starter_preset.c b/sources/app/starter_preset.c
--- a/sources/app/starter_preset.c
+++ b/sources/app/starter_preset.c
@@ -0,0 +1,39 @@
+#include "starter_preset.h"
+
+#include "app/firmware_runtime.h"
+#include "audio/effects/effect_catalog.h"
+
+typedef struct {
+    gp100_effect_family_t family;
+    uint16_t algorithm;      /* index in the family's catalog */
+    bool enabled;
+    uint8_t footswitches;    /* bit n = footswitch n+1 toggles this block */
+} starter_block_t;
+
+static const starter_block_t k_chain[] = {
+    {GP100_EFFECT_DISTORTION, 6u, true, 1u << 0},     /* Green OD   - FS1 */
+    {GP100_EFFECT_AMPLIFIER, 1u, true, 0u},           /* Bellman 59N */
+    {GP100_EFFECT_CABINET, 31u, true, 0u},            /* Bellman 4x10 */
+    {GP100_EFFECT_DELAY, 6u, false, 1u << 1},         /* Slapback   - FS2, off until switched on */
+    {GP100_EFFECT_REVERB, 4u, true, 0u},              /* Spring */
+};
+
+bool gp100_make_starter_preset(gp100_preset_record_t *preset)
+{
+    size_t i;
+
+    if (preset == NULL || !gp100_make_development_preset(preset, "Starter")) { return false; }
+    gp100_patch_init(preset);
+    for (i = 0u; i < sizeof(k_chain) / sizeof(k_chain[0]); ++i) {
+        gp100_patch_block_t block;
+
+        if (gp100_patch_insert(preset, i, k_chain[i].family, k_chain[i].algorithm) != GP100_PATCH_OK ||
+            !gp100_patch_block_at(preset, i, &block)) {
+            return false;
+        }
+        block.enabled = k_chain[i].enabled;
+        block.footswitches = k_chain[i].footswitches;
+        if (!gp100_patch_update(preset, &block)) { return false; }
+    }
+    return gp100_patch_validate(preset) && gp100_patch_count(preset) == sizeof(k_chain) / sizeof(k_chain[0]);
+}
diff -ruN -x __pycache__ a/sources/app/starter_preset.h b/sources/app/starter_preset.h
--- a/sources/app/starter_preset.h
+++ b/sources/app/starter_preset.h
@@ -0,0 +1,12 @@
+#ifndef GP100_STARTER_PRESET_H
+#define GP100_STARTER_PRESET_H
+
+#include "storage/patch_chain.h"
+
+#include <stdbool.h>
+
+/* Build the built-in "Starter" preset: Green OD (FS1) -> Bellman 59N -> Bellman 4x10 -> Slapback (FS2, off) -> Spring.
+ * Returns false if any step is refused by the chain rules (the caller then falls back to an empty preset). */
+bool gp100_make_starter_preset(gp100_preset_record_t *preset);
+
+#endif
